# Copia este archivo a .env.local y completa con tus valores.
# .env.local nunca se sube a git (ver .gitignore: *.local).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Maps (Google Cloud Console -> Credentials)
# Habilitar: Maps JavaScript API, Routes API (NO "Directions API", deprecada)
VITE_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# Modo prueba (opcional): deja fijar una ubicación manual por GPS simulado
# en vez de depender del GPS real del celular, y sube la tolerancia de
# cercanía a la ruta. Útil para probar con gente que no está físicamente
# sobre la ruta. Déjalo en "false" o bórralo fuera de las pruebas.
VITE_TEST_MODE=false
VITE_TEST_TOLERANCE_M=2000

# Servicio de recomendación (AHP + lógica difusa, ver recommendation-service/).
# Vacío en producción (Vercel): el servicio corre solo local para esta
# entrega y la búsqueda degrada en silencio al orden por distancia si no
# está disponible. Local: levanta `uvicorn app.main:app --reload` dentro de
# recommendation-service/ y pon aquí su URL.
VITE_RECOMMENDATION_API_URL=http://localhost:8000
