# Copia este archivo a .env.local y completa con tus valores.
# .env.local nunca se sube a git (ver .gitignore: *.local).

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Maps (Google Cloud Console -> Credentials)
# Habilitar: Maps JavaScript API, Directions API
VITE_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps
